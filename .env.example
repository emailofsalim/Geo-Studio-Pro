# ---------------------------------------------------------------------------
# BhuNex Studio server configuration
#
# Everything here is read by the server and by the deployed serverless
# functions. None of it reaches the browser bundle: the AI key in particular is
# only ever held server-side, which is why the AI calls go through this
# application's own endpoints rather than to the provider from the page.
# ---------------------------------------------------------------------------

# The Gemini key. Without it the AI features still answer, using the local
# geomatics engine, and /api/ai/status reports provider "opensource".
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Where this instance is hosted. Used for self-referential links.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Abuse controls on the AI endpoints
#
# These endpoints spend money with the key above, and this application has no
# user accounts, so the settings below are abuse mitigation and not
# authentication. Read the note in src/server/requestGuard.ts before exposing a
# deployment publicly -- in particular, none of this is a substitute for a spend
# cap set at the provider.
# ---------------------------------------------------------------------------

# Bearer token. When set, callers must send "Authorization: Bearer <token>" and
# the origin check is skipped. This is the right control for machine clients and
# for any deployment reachable from the open internet. A browser page cannot
# keep a secret, so setting this will stop the application's own UI from calling
# the endpoints unless you put a proxy in front that adds the header.
# AI_API_TOKEN=""

# Extra origins allowed to call the endpoints, comma separated. The deployment's
# own origin is always allowed; this is for a separate front end or a staging
# host. Leave empty for same-origin only.
# ALLOWED_ORIGINS="https://staging.example.com"

# Rate limit per client address. Defaults: 20 requests per 60000 ms.
# The counter lives in the process, so on serverless it is per warm instance and
# the effective ceiling is this number multiplied by however many are warm.
# AI_RATE_MAX="20"
# AI_RATE_WINDOW_MS="60000"

# Largest accepted request body in bytes. Default 65536, which is a prompt and
# its workspace context; the endpoints previously accepted 10 MB.
# AI_MAX_BODY_BYTES="65536"

# ---------------------------------------------------------------------------
# Self-hosting
# ---------------------------------------------------------------------------

# The server binds to loopback by default so that starting it does not publish
# the AI endpoints on every interface. Set this deliberately to expose it.
# HOST="0.0.0.0"
# PORT="3000"
